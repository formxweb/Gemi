---
import Img from './Img.astro';
import { fleet } from '../data/fleet.js';
import { wa, contact } from '../data/site.js';
import haze from '../assets/img/haze.jpg';

interface Props { lang: 'en' | 'tr' }
const { lang } = Astro.props;
const L = (en: string, tr: string) => (lang === 'en' ? en : tr);

const occasions = lang === 'en'
  ? ['Private Events', 'Corporate Hosting', 'Celebrations', 'Private Dining', 'Custom Charter']
  : ['Özel Davetler', 'Kurumsal Ağırlama', 'Kutlamalar', 'Özel Yemek', 'Size Özel Rota'];
const times = lang === 'en' ? ['Daytime', 'Sunset', 'Evening'] : ['Gündüz', 'Gün batımı', 'Akşam'];
const durations = lang === 'en' ? ['2 hours', '3 hours', '4 hours', 'Full day'] : ['2 saat', '3 saat', '4 saat', 'Tam gün'];
const guestsOpts = ['2–12', '13–20', '21–40', '41–60'];
const advise = L('Advise me', 'Siz önerin');
---

<section class="ch" data-nav="light">
  <header class="ch__head wrap grid">
    <p class="eyebrow ch__eyebrow">{L('Private Charter', 'Özel Kiralama')}</p>
    <h1 class="display ch__title">{L('Plan your experience.', 'Deneyiminizi planlayın.')}</h1>
    <p class="ch__intro">
      {L(
        'Tell us what you have in mind. Your request goes directly to our charter team on WhatsApp, and we reply with a yacht, a route and a quote.',
        'Aklınızdakini anlatın. Talebiniz WhatsApp üzerinden doğrudan kiralama ekibimize ulaşır; size bir yat, bir rota ve bir fiyatla dönüyoruz.'
      )}
    </p>
  </header>

  <div class="ch__band frame"><Img src={haze} alt={L('A boat crossing the Bosphorus in the evening haze', 'Akşam puslu havada Boğaz’ı geçen bir tekne')} sizes="100vw" position="50% 56%" /></div>

  <div class="wrap grid ch__body">
    <form class="ch__form" id="charter-form" novalidate>
      <fieldset class="sec">
        <legend class="sec__legend"><span class="sec__n serif">I</span>{L('The occasion', 'Vesile')}</legend>
        <div class="chips">
          {occasions.map((o, i) => (
            <label class="chip"><input type="radio" name="occasion" value={o} checked={i === 0} /><span>{o}</span></label>
          ))}
        </div>
      </fieldset>

      <fieldset class="sec">
        <legend class="sec__legend"><span class="sec__n serif">II</span>{L('The yacht', 'Yat')}</legend>
        <div class="yachts">
          {fleet.map((y) => (
            <label class="yopt">
              <input type="radio" name="yacht" value={y.slug} data-name={y.name} />
              <span class="yopt__name serif">{y.name}</span>
              <span class="yopt__spec num">{y.specs.length} m · {y.specs.guests} {L('guests', 'misafir')}</span>
            </label>
          ))}
          <label class="yopt">
            <input type="radio" name="yacht" value="advise" data-name={advise} checked />
            <span class="yopt__name serif">{advise}</span>
            <span class="yopt__spec">{L('We match the yacht to your guests', 'Misafir sayınıza göre yat öneririz')}</span>
          </label>
        </div>
      </fieldset>

      <fieldset class="sec">
        <legend class="sec__legend"><span class="sec__n serif">III</span>{L('Date & guests', 'Tarih ve misafir')}</legend>
        <div class="two">
          <div class="field"><label for="c-date">{L('Date', 'Tarih')}</label><input id="c-date" name="date" type="date" required /></div>
          <div class="field"><label for="c-guests">{L('Guests', 'Misafir')}</label><select id="c-guests" name="guests">{guestsOpts.map((g) => <option>{g}</option>)}</select></div>
          <div class="field"><span class="label">{L('Time of day', 'Saat')}</span>
            <div class="chips chips--small">{times.map((t, i) => <label class="chip"><input type="radio" name="time" value={t} checked={i === 1} /><span>{t}</span></label>)}</div>
          </div>
          <div class="field"><label for="c-dur">{L('Duration', 'Süre')}</label><select id="c-dur" name="duration">{durations.map((d, i) => <option selected={i === 1}>{d}</option>)}</select></div>
        </div>
      </fieldset>

      <fieldset class="sec">
        <legend class="sec__legend"><span class="sec__n serif">IV</span>{L('Your details', 'Bilgileriniz')}</legend>
        <div class="two">
          <div class="field"><label for="c-name">{L('Name', 'Ad soyad')}</label><input id="c-name" name="name" autocomplete="name" required /></div>
          <div class="field"><label for="c-phone">{L('Phone', 'Telefon')}</label><input id="c-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required /></div>
          <div class="field two__wide"><label for="c-notes">{L('Anything we should know', 'Bilmemiz gerekenler')}</label><textarea id="c-notes" name="notes" rows="3" placeholder={L('Menu, music, flowers, a surprise…', 'Menü, müzik, çiçek, bir sürpriz…')}></textarea></div>
        </div>
      </fieldset>

      <div class="ch__submit">
        <p class="ch__error" role="alert" hidden>{L('Please add a date, your name and a phone number.', 'Lütfen tarih, ad soyad ve telefon bilgisini ekleyin.')}</p>
        <button type="submit" class="btn solid">{L('Send request via WhatsApp', 'Talebi WhatsApp ile gönder')}<span aria-hidden="true">→</span></button>
        <p class="small">{L('Your details are used only to reply to this request.', 'Bilgileriniz yalnızca bu talebe yanıt vermek için kullanılır.')}</p>
      </div>
    </form>

    <aside class="brief" aria-live="polite">
      <div class="brief__inner">
        <p class="eyebrow">{L('Your brief', 'Talebiniz')}</p>
        <dl class="brief__list">
          <div><dt>{L('Occasion', 'Vesile')}</dt><dd data-b="occasion">—</dd></div>
          <div><dt>{L('Yacht', 'Yat')}</dt><dd data-b="yacht">—</dd></div>
          <div><dt>{L('Date', 'Tarih')}</dt><dd data-b="date">—</dd></div>
          <div><dt>{L('Guests', 'Misafir')}</dt><dd data-b="guests">—</dd></div>
          <div><dt>{L('Time', 'Saat')}</dt><dd data-b="when">—</dd></div>
        </dl>
        <div class="brief__direct">
          <p class="small">{L('Prefer to talk?', 'Konuşmayı mı tercih edersiniz?')}</p>
          <a href={wa()} target="_blank" rel="noopener">WhatsApp</a>
          <a href={contact.phoneHref} class="num">{contact.phoneDisplay}</a>
        </div>
      </div>
    </aside>
  </div>
</section>

<style>
  .ch { padding-top: clamp(130px, 14vw, 200px); }
  .ch__head { align-items: end; padding-bottom: clamp(56px, 6vw, 90px); }
  .ch__eyebrow { grid-column: 1 / 4; margin: 0 0 14px; align-self: start; padding-top: 18px; }
  .ch__title { grid-column: 4 / 11; font-size: clamp(48px, 7vw, 116px); }
  .ch__intro { grid-column: 8 / 12; margin: clamp(32px, 4vw, 56px) 0 0; color: #4b4a45; font-size: 16px; }
  .ch__band { height: clamp(220px, 30vw, 440px); }

  .ch__body { padding-block: clamp(80px, 9vw, 130px) clamp(110px, 12vw, 170px); align-items: start; }
  .ch__form { grid-column: 1 / 8; display: grid; gap: clamp(56px, 6vw, 84px); }
  .sec { border: 0; margin: 0; padding: 0; min-width: 0; }
  .sec__legend { display: flex; align-items: baseline; gap: 18px; padding: 0 0 28px; font-size: 12px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; }
  .sec__n { font-size: 26px; font-style: italic; font-weight: 300; letter-spacing: 0; text-transform: none; color: var(--stone); min-width: 1.6em; }

  .chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip input, .yopt input { position: absolute; opacity: 0; pointer-events: none; }
  .chip span {
    display: inline-block;
    padding: 12px 18px 11px;
    border: 1px solid var(--line);
    font-size: 14.5px;
    cursor: pointer;
    transition: border-color 0.3s var(--ease), background-color 0.3s var(--ease), color 0.3s var(--ease);
  }
  .chip:hover span { border-color: var(--ink); }
  .chip input:checked + span { background: var(--ink); color: var(--bone); border-color: var(--ink); }
  .chip input:focus-visible + span { outline: 1px solid var(--ink); outline-offset: 3px; }
  .chips--small .chip span { padding: 9px 14px 8px; font-size: 13.5px; }

  .yachts { display: grid; border-top: 1px solid var(--line); }
  .yopt {
    position: relative;
    display: grid;
    grid-template-columns: 22px 1fr auto;
    align-items: baseline;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    cursor: pointer;
  }
  .yopt::before { content: ''; width: 9px; height: 9px; border: 1px solid var(--ink); border-radius: 50%; transform: translateY(-2px); transition: background 0.3s; }
  .yopt:has(input:checked)::before { background: var(--ink); }
  .yopt:has(input:focus-visible) { outline: 1px solid var(--ink); outline-offset: 2px; }
  .yopt__name { font-size: 24px; font-weight: 300; }
  .yopt__spec { font-size: 13px; color: var(--stone); letter-spacing: 0.04em; }

  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 36px 32px; }
  .two__wide { grid-column: 1 / -1; }
  .field textarea { resize: vertical; font-size: 20px; }

  .ch__submit { display: grid; gap: 16px; justify-items: start; padding-top: 8px; }
  .ch__error { margin: 0; color: var(--signal); font-size: 14px; }

  .brief { grid-column: 9 / 13; position: sticky; top: 110px; }
  .brief__inner { border-top: 1px solid var(--ink); padding-top: 22px; }
  .brief__inner > .eyebrow { margin: 0 0 18px; }
  .brief__list { margin: 0; }
  .brief__list > div { display: grid; grid-template-columns: 90px 1fr; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
  .brief__list dt { color: var(--stone); }
  .brief__list dd { margin: 0; font-family: var(--serif); font-size: 18px; line-height: 1.3; }
  .brief__direct { margin-top: 40px; display: grid; gap: 4px; font-size: 15px; }
  .brief__direct .small { margin: 0 0 6px; }
  .brief__direct a { width: fit-content; border-bottom: 1px solid var(--line); }

  @media (max-width: 1080px) {
    .ch__form { grid-column: 1 / 13; }
    .brief { display: none; }
  }
  @media (max-width: 800px) {
    .ch__eyebrow, .ch__title, .ch__intro { grid-column: 1 / -1; }
    .ch__title { margin-top: 16px; }
    .ch__form { grid-column: 1 / -1; }
    .two { grid-template-columns: 1fr; }
    .yopt { grid-template-columns: 18px 1fr; }
    .yopt__spec { grid-column: 2; }
    .ch__submit .btn { width: 100%; }
  }
</style>

<script>
  import { contact } from '../data/site.js';

  function initCharter() {
    const form = document.querySelector<HTMLFormElement>('#charter-form');
    if (!form) return;
    const lang = document.documentElement.lang;
    const q = new URLSearchParams(location.search);

    // Prefill from links and short forms elsewhere on the site.
    const yacht = q.get('yacht');
    if (yacht) form.querySelector<HTMLInputElement>(`input[name="yacht"][value="${CSS.escape(yacht)}"]`)?.click();
    const occ = q.get('occasion');
    if (occ) [...form.querySelectorAll<HTMLInputElement>('input[name="occasion"]')].find((i) => i.value === occ)?.click();
    const date = q.get('date');
    if (date) (form.elements.namedItem('date') as HTMLInputElement).value = date;
    const guests = q.get('guests');
    if (guests) (form.elements.namedItem('guests') as HTMLSelectElement).value = guests;

    const today = new Date().toISOString().slice(0, 10);
    (form.elements.namedItem('date') as HTMLInputElement).min = today;

    const val = (n: string) => {
      const el = form.elements.namedItem(n) as RadioNodeList | HTMLInputElement | null;
      return el ? (el as HTMLInputElement).value : '';
    };
    const yachtName = () => form.querySelector<HTMLInputElement>('input[name="yacht"]:checked')?.dataset.name || '';
    const fmtDate = (d: string) => {
      if (!d) return '';
      const dt = new Date(d + 'T12:00:00');
      return dt.toLocaleDateString(lang === 'tr' ? 'tr-TR' : 'en-GB', { weekday: 'short', day: 'numeric', month: 'long', year: 'numeric' });
    };

    const render = () => {
      const set = (k: string, v: string) => { const el = document.querySelector(`[data-b="${k}"]`); if (el) el.textContent = v || '—'; };
      set('occasion', val('occasion'));
      set('yacht', yachtName());
      set('date', fmtDate(val('date')));
      set('guests', val('guests'));
      set('when', [val('time'), val('duration')].filter(Boolean).join(' · '));
    };
    form.addEventListener('input', render);
    form.addEventListener('change', render);
    render();

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const err = form.querySelector<HTMLElement>('.ch__error')!;
      const missing = ['date', 'name', 'phone'].filter((n) => !val(n).trim());
      err.hidden = missing.length === 0;
      if (missing.length) {
        (form.elements.namedItem(missing[0]) as HTMLElement).focus();
        return;
      }
      const tr = lang === 'tr';
      const lines = [
        tr ? 'Merhaba Denden, özel bir kiralama talebim var.' : 'Hello Denden, I would like to request a private charter.',
        '',
        `${tr ? 'Vesile' : 'Occasion'}: ${val('occasion')}`,
        `${tr ? 'Yat' : 'Yacht'}: ${yachtName()}`,
        `${tr ? 'Tarih' : 'Date'}: ${fmtDate(val('date'))}`,
        `${tr ? 'Misafir' : 'Guests'}: ${val('guests')}`,
        `${tr ? 'Saat' : 'Time'}: ${val('time')} · ${val('duration')}`,
        '',
        `${tr ? 'Ad' : 'Name'}: ${val('name')}`,
        `${tr ? 'Telefon' : 'Phone'}: ${val('phone')}`,
      ];
      if (val('notes').trim()) lines.push('', `${tr ? 'Not' : 'Notes'}: ${val('notes').trim()}`);
      window.open(`https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener');
    });
  }
  document.addEventListener('astro:page-load', initCharter);
</script>
<style>
  .field .chip { text-transform: none; letter-spacing: 0; font-weight: 400; font-size: inherit; }
</style>
