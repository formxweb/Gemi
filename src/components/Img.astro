---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  eager?: boolean;
  position?: string;
  class?: string;
}
const { src, alt, sizes = '100vw', eager = false, position, class: cls } = Astro.props;
const widths = [480, 800, 1200, 1600, 2000, 2600].filter((w) => w <= src.width);
if (!widths.includes(src.width) && src.width < 2600) widths.push(src.width);
---
<Picture
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  formats={['webp']}
  fallbackFormat="jpg"
  quality={78}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  decoding="async"
  class={cls}
  style={position ? `object-position:${position}` : undefined}
/>
