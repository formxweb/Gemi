  .req__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 28px; margin-top: 12px; }
  .req__wa { font-size: 14px; color: var(--mist); border-bottom: 1px solid var(--line-light); padding-bottom: 4px; }
  .req__wa:hover { color: var(--bone); border-color: var(--bone); }
