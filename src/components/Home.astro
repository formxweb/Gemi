    .about__facts { grid-template-columns: 1fr 1fr; gap: 28px; }
    .close__line em { padding-left: 0.6em; }
    .close__cta { justify-content: stretch; }
    .close__cta .btn { width: 100%; }
  }
</style>

<script>
  function initHome() {
    const hero = document.querySelector('.hero');
    if (hero) requestAnimationFrame(() => requestAnimationFrame(() => hero.classList.add('is-in')));

    const els = [...document.querySelectorAll<HTMLElement>('[data-expand]')];
    if (!els.length || matchMedia('(prefers-reduced-motion: reduce)').matches) {
      els.forEach((el) => el.style.setProperty('--p', '1'));
      return;
    }
    let ticking = false;
    const run = () => {
      ticking = false;
      const vh = window.innerHeight;
      for (const el of els) {
        const r = el.getBoundingClientRect();
        // 0 when the section enters from below, 1 once its top reaches ~15% of the viewport
        const p = Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.85)));
        el.style.setProperty('--p', p.toFixed(3));
      }
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(run); } };
    run();
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:before-swap', () => window.removeEventListener('scroll', onScroll), { once: true });
  }
  document.addEventListener('astro:page-load', initHome);
</script>
