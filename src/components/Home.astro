  /* 5 — Figures */
  .figures { background: #e8e3da; padding-block: clamp(90px, 11vw, 160px) clamp(70px, 8vw, 120px); }
  .figures__head { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid var(--line); padding-bottom: 22px; }
