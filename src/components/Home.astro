  /* 10 — About + close */
  .about { padding-block: clamp(110px, 13vw, 190px); }
  .about__img { grid-column: 1 / 6; aspect-ratio: 4 / 5; }
  .about__text { grid-column: 7 / 12; align-self: center; }
  .about__text .eyebrow { margin: 0 0 28px; }
  .about__text .lede { font-size: clamp(24px, 2.4vw, 36px); }
  .about__facts { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 44px; margin: 48px 0 0; }
  .about__facts dt { margin-bottom: 8px; color: var(--stone); }
  .about__facts dd { margin: 0; font-family: var(--serif); font-size: 21px; }

  .close { padding-block: clamp(120px, 15vw, 220px) clamp(60px, 7vw, 100px); border-bottom: 1px solid var(--line-light); }
  .close__line { font-size: clamp(56px, 10vw, 168px); line-height: 0.94; }
  .close__line em { font-style: italic; font-weight: 300; padding-left: 1.1em; color: var(--mist); }
  .close__cta { display: flex; justify-content: flex-end; margin-top: clamp(48px, 6vw, 90px); }

  /* ---------- Tablet ---------- */
  @media (max-width: 1080px) {
    .flag__main { grid-column: 1 / 13; }
    .flag__side { grid-column: 1 / 13; grid-template-columns: 1fr 1.4fr; grid-template-rows: auto; padding: 32px 0 0; align-items: end; }
    .flag__inset { width: 100%; }
    .steps { grid-template-columns: repeat(2, 1fr); row-gap: 48px; }
  }

  /* ---------- Phone ---------- */
  @media (max-width: 800px) {
    .hero { min-height: 100svh; grid-template-rows: auto auto 1fr; }
    .hero__img { position: relative; width: 100%; height: 74svh; grid-row: 1; }
    .hero__base { grid-row: 2; grid-template-columns: 1fr; margin-top: -0.52em; gap: 0; font-size: clamp(56px, 16vw, 110px); padding-bottom: 0; }
    .hero__mark :global(.wm__name) { font-size: clamp(50px, 14.6vw, 110px); }
    .hero__meta { display: none; }
    .hero__copy { grid-row: 3; align-self: start; max-width: none; padding: 26px var(--gutter) 36px; display: flex; justify-content: space-between; gap: 20px; align-items: flex-end; }
    .hero__copy .eyebrow { margin: 0 0 4px; order: 2; text-align: right; max-width: 12ch; }
    .hero__line { font-size: 21px; }

    .statement__label, .statement__text, .statement__aside { grid-column: 1 / -1; }
    .statement__text { margin-top: 28px; }
    .statement__aside { margin-top: 36px; }
    .editorial__frame { height: 72svh; }
    .editorial__cap { flex-direction: column; gap: 4px; }

    .fleet__head .eyebrow, .fleet__title { grid-column: 1 / -1; }
    .fleet__title { margin-top: 20px; }
    .flag__main { grid-column: 1 / -1; aspect-ratio: 4 / 5; }
    .flag__side { grid-column: 1 / -1; grid-template-columns: 1fr; }
    .flag__inset { display: none; }
    .pair__item--0, .pair__item--1 { grid-column: 1 / -1; margin-top: 0; }
    .pair__item--1 { margin-top: 72px; }
    .pair__item--1 .pair__img { width: 82%; margin-left: auto; }
    .index-row { grid-template-columns: 1fr auto; row-gap: 6px; }
    .index-row > .eyebrow { display: none; }
    .index-row__cta { grid-column: 1 / -1; margin-top: 8px; }

    .figures__head { flex-direction: column; gap: 10px; }
    .figures__row { grid-template-columns: 1fr 1fr; }
    .figures__row > div:nth-child(3) { border-left: 0; padding-left: 0; }
    .figures__row > div { border-top: 1px solid var(--line); }
    .figures__row > div:nth-child(-n + 2) { border-top: 0; }
    .figures__img .frame { aspect-ratio: 4 / 3; }
    .figures__cap { flex-direction: column; align-items: flex-start; gap: 4px; }

    .bos__head .eyebrow, .bos__title, .bos__intro { grid-column: 1 / -1; }
    .bos__title { margin-top: 22px; }
    .evening { grid-template-columns: repeat(6, minmax(0, 1fr)); row-gap: 56px; }
    .evening__item--0 { grid-column: 1 / -1; }
    .evening__item--1 { grid-column: 2 / -1; margin-top: 0; }
